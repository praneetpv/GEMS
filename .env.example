# PostgreSQL connection string (own database, not shared with the GlowUp LMS)
DATABASE_URL=

# Microsoft Entra ID SSO — same tenant as GlowUp, but its OWN App Registration
# ("Dbiz Employee Appraisal") with its own client id/secret/redirect URI.
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=

# Microsoft Graph app-only mail sending (goal/feedback/review notifications).
# Can reuse the same App Registration as SSO above (client-credentials flow
# needs no redirect URI) or a separate one if IT prefers a distinct sender.
MAIL_SENDER_ADDRESS=
